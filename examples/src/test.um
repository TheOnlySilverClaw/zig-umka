import "module.um"

fn sayHello() {
    printf("Hello from Umka!\n")
}

fn greeting(name: str): str {
    return "Hello " + name + "!"
}

fn add(a: int, b: int): int {
    return a + b
}

fn neighbors(value: int): (int, int) {
    return value - 1, value + 1
}

// implemented in Zig
fn zigMultiply*(a, b: int): int

fn callZig() {
    value := zigMultiply(1000, 1234)
    printf("Value from Zig: %d\n", value)
}